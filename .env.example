# ==============================================================================
# MEDIAFORGE AI — Environment Configuration Example
# ==============================================================================

# Database
DATABASE_URL="file:./dev.db"

# NextAuth v5
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"

# Cloudinary (Sign up at https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# AI Provider ("gemini" | "openai" | "anthropic")
AI_PROVIDER="gemini"
AI_API_KEY="your-ai-api-key"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo Mode (true/false)
DEMO_MODE="true"
